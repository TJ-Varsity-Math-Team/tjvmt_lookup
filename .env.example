BASE_URL=http://localhost:3000

OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_AUTHORIZATION_URL=https://ion.tjhsst.edu/oauth/authorize
OAUTH_TOKEN_URL=https://ion.tjhsst.edu/oauth/token
OAUTH_REDIRECT_URL=${BASE_URL}/api/callback

# Optional: override cookie lifetime when provider doesn't return expires_in
SESSION_MAX_AGE_SECONDS=600
